# --- Email auto-fetch (IMAP) ---
REPORT_IMAP_HOST=imap.rediffmailpro.com
REPORT_IMAP_PORT=993
REPORT_EMAIL=report@example.com
REPORT_EMAIL_PASSWORD=

# --- Access control (shared PIN) ---
# Strong, non-guessable. Used to log in to the web UI.
DAILYFLASH_PIN=

# --- Session signing ---
# Random 32+ chars. Used to sign session tokens. Rotating invalidates all sessions.
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=

# --- Data-at-rest encryption (REQUIRED in production) ---
# 32 raw bytes encoded as base64. Encrypts every daily report payload before
# it lands in MongoDB or on backend disk. WITHOUT THIS KEY THE DATA IS UNREADABLE,
# so back it up to a password manager.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=

# --- CORS allow-list (REQUIRED in production) ---
# Comma-separated list of origins allowed to call the API. In dev (NODE_ENV unset)
# all origins are allowed. In production only origins in this list are accepted.
# Example: https://daily-flash.vercel.app,https://daily-flash-git-main.vercel.app
ALLOWED_ORIGINS=

# --- Optional: MongoDB persistence ---
# When set, daily payloads are stored encrypted in MongoDB. Leave blank for local JSON files.
MONGODB_URI=

# --- Optional: hosted import scheduler on Render ---
ENABLE_CLOUD_IMPORT=false
CLOUD_API_URL=

# --- Anthropic API (for AI notes) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# --- Runtime flag ---
# Set to 'production' on Render. Enables HSTS, strict CORS, and required-key checks.
NODE_ENV=production
